{
  "name": "book-illustration-studio",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run setup && npm run dev",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "generate:api-types": "tsx scripts/generate-openapi-types.ts",
    "lint": "eslint backend/src frontend/src",
    "test": "npm --workspace backend test && npm --workspace frontend test",
    "setup": "npm install && npm --workspace backend run migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "typescript-eslint": "^8.46.1"
  }
}
